# Entorno virtual
.venv/
venv/
env/

# Build / distribución
dist/
dist_*/
build/
*.zip
# ...menos el paquete de presets de fábrica, que sí se versiona
# (regenerarlo con tools/gen_presets_zip.py — es determinista, no genera diff
# si no cambió ningún preset)
!Presets/Presets.zip
*.egg-info/

# PyInstaller
*.spec.bak

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# Configuración de usuario de la APP (no compartir) — anclado a la raíz:
# sin la barra inicial también ignoraría .claude/settings.json
/settings.json

# Permisos locales de Claude Code: son de esta máquina (rutas absolutas y
# nombre de usuario), no del proyecto. El settings.json de .claude/ SÍ se
# versiona: ahí viven los hooks, que son convención del repo.
.claude/settings.local.json

# Grabaciones del usuario
Grabaciones/

# Perfiles de ruido nombrados del usuario (data de runtime, junto al exe)
PerfilesRuido/

# Archivos generados (se regeneran desde MANUAL.md)
MANUAL_*.pdf

# Modelos ONNX grandes (descargar por separado)
*.onnx

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Datos escribibles de la app (viven junto al ejecutable, no en el repo).
# errores_dsp.log en particular NUNCA debe versionarse: es diagnostico de la
# maquina del usuario, y tenerlo en la carpeta del proyecto ya causo una vez
# que se tomara por un fallo real lo que habia dejado la suite de tests.
errores_dsp.log
